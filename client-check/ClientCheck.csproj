<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same Nakama .NET client the Unity SDK v3.23.0 bundles. -->
    <PackageReference Include="NakamaClient" Version="3.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile the exact file the Unity project uses. -->
    <Compile Include="../unity/Assets/Scripts/Nakama/NakamaAuthFlow.cs" Link="NakamaAuthFlow.cs" />
  </ItemGroup>

</Project>
